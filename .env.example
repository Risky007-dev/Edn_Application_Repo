# ==============================================================================
# TUTOR TIME & POPCORN MATH - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for your local environment or production server.
# NEVER commit credentials, secret keys, or live passwords to version control.
# ==============================================================================

# Primary site URL (used for canonical URLs, sitemaps, robots.txt, and Open Graph metadata)
# Local: http://localhost:5001 | Production: https://tutortime.ai
SITE_URL=http://localhost:5001
PUBLIC_SITE_URL=http://localhost:5001

# Port for HTTP server (default: 5001)
PORT=5001

# Environment mode: development, test, or production
NODE_ENV=development

# Trust reverse proxy headers (e.g. AWS ALB, Nginx, Cloudflare) - true or false
TRUST_PROXY=false

# Storage driver: 'local' (offline JSON files, no AWS required) or 'aws' (DynamoDB, S3, SES)
STORAGE_DRIVER=local

# Directory path for local flat-file submission persistence (default: ./data)
DATA_DIR=./data

# Local JSON file path for legacy newsletter subscriber persistence (default: ./subscribers.json)
SUBSCRIBERS_DB_FILE=./subscribers.json

# Maximum form submissions allowed per IP per 15-minute window (default: 5; local dev: 50)
FORM_RATE_LIMIT_MAX=50

# Secret key required in X-Admin-Key header to access /api/metrics endpoint
ADMIN_API_KEY=local-dev-admin-key-2026

# Dedicated WhatsApp Business contact number with country code (+1 264 for Anguilla)
WHATSAPP_PHONE_NUMBER=+12647295791

# ==============================================================================
# FEATURE FLAGS & LOCAL PREVIEW
# ==============================================================================

# Optional prominent banner at the top of pages indicating local preview environment
# (default: false; off in production)
SHOW_LOCAL_PREVIEW_BANNER=false

# Chatbot feature flag: true (enabled) or false (kill-switch)
FEATURES_CHATBOT_ENABLED=true

# Gamified CPEA Readiness Check feature flag: true (enabled) or false
FEATURES_READINESS_CHECK_ENABLED=true

# ==============================================================================
# CLAUDE AI CHATBOT (Tutor Time Helper) CONFIGURATION
# ==============================================================================

# Anthropic Claude API model identifier (default: claude-3-5-haiku-20241022)
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Anthropic API key (keep blank in local dev if not testing live AI responses)
# When missing, the site gracefully falls back and the chat widget remains dormant.
ANTHROPIC_API_KEY=

# Maximum chatbot requests allowed per calendar day across all users (cost protection)
CHATBOT_DAILY_REQUEST_CAP=200

# Chatbot IP rate limit: maximum questions allowed per window
CHATBOT_RATE_LIMIT_MAX=10

# Chatbot IP rate limit window in minutes
CHATBOT_RATE_LIMIT_WINDOW_MINUTES=10

# Maximum character length for user questions
CHATBOT_MAX_INPUT_LENGTH=500

# ==============================================================================
# EMAIL NOTIFICATION CONFIGURATION (AWS SESv2 - Production only)
# ==============================================================================

# Recipient email for internal submission notifications
ADMIN_NOTIFICATION_EMAIL=notifications@popcornmaths.com

# Outgoing notification sender email address (must be verified in Amazon SES)
SENDER_EMAIL=hello@popcornmaths.com

# Public contact / privacy support email address
CONTACT_EMAIL=hello@popcornmaths.com

# Toggle applicant confirmation emails: true or false (keep false in SES sandbox)
SEND_CONFIRMATIONS=false

# ==============================================================================
# AWS INFRASTRUCTURE (Required only when STORAGE_DRIVER=aws)
# ==============================================================================

# AWS region for DynamoDB, S3, and SESv2 clients
AWS_REGION=us-east-2

# Name of DynamoDB table for form submissions
DYNAMODB_TABLE_NAME=tutortime-submissions

# Name of private S3 bucket for applicant CV uploads
UPLOADS_BUCKET_NAME=tutortime-production-infra-uploadsbucket-s0sf7c8ntwfh

# Fault injection testing toggle (disabled by default)
FAULT_INJECTION_ENABLED=false
FAULT_INJECTION_KEY=

# ==============================================================================
# TUTOR TIME & POPCORN MATH - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for your local environment or production server.
# NEVER commit credentials, secret keys, or live passwords to version control.
# ==============================================================================

# Port for HTTP server (default 5001)
PORT=

# Trust proxy headers when running behind reverse proxy or ALB (true or false)
TRUST_PROXY=

# Storage driver: local (offline flat file) or aws (DynamoDB, S3, SES)
STORAGE_DRIVER=

# Directory path for local flat-file submission storage (default ./data)
DATA_DIR=

# AWS region for DynamoDB, S3, and SESv2 clients (default us-east-2)
AWS_REGION=

# Name of DynamoDB table for form submissions (default tutortime-submissions)
DYNAMODB_TABLE_NAME=

# Name of private S3 bucket for applicant CV uploads
UPLOADS_BUCKET_NAME=

# Recipient email for internal submission notifications; address must belong to an SES-verified identity
ADMIN_NOTIFICATION_EMAIL=

# Outgoing notification sender email address; address must belong to an SES-verified identity
SENDER_EMAIL=

# Secret key required in X-Admin-Key header to access /api/metrics endpoint
ADMIN_API_KEY=

# Toggle applicant confirmation emails: true or false (keep false in SES sandbox)
SEND_CONFIRMATIONS=

# Dedicated WhatsApp Business contact number with country code
WHATSAPP_PHONE_NUMBER=

# Maximum form submissions allowed per IP per 15-minute window (default 5)
FORM_RATE_LIMIT_MAX=

# Local JSON file path for email subscriber persistence (default ./subscribers.json)
SUBSCRIBERS_DB_FILE=

# ==============================================================================
# LEGACY CONFIGURATION (Python/Flask prototype - Preserved for reference)
# ==============================================================================
# LEGACY: SMTP server host for prototype Flask email dispatch
SMTP_SERVER=

# LEGACY: SMTP port for prototype Flask email dispatch
SMTP_PORT=

# LEGACY: App-specific password for prototype Gmail SMTP
SENDER_PASSWORD=

# LEGACY: SQLite database connection string for prototype Flask app
DATABASE_URL=

# LEGACY: Flask environment mode
FLASK_ENV=

# LEGACY: Flask debug mode toggle
FLASK_DEBUG=

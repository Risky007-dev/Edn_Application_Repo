# ==============================================================================
# TUTOR TIME & POPCORN MATH - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for your local environment or production server.
# NEVER commit credentials, secret keys, or live passwords to version control.
# ==============================================================================

# Local HTTP port for the Express application server (default: 5001)
PORT=

# Runtime environment mode: development, production, test (default: development)
NODE_ENV=

# Storage driver: local (offline flat JSON file) or aws (DynamoDB, S3, SES)
STORAGE_DRIVER=

# Directory path for local flat-file submission persistence (default: ./data)
DATA_DIR=

# Local JSON file path for email subscriber persistence (default: ./subscribers.json)
SUBSCRIBERS_DB_FILE=

# AWS region for DynamoDB, S3, and SESv2 clients (default: us-east-2)
AWS_REGION=

# Name of the DynamoDB table for form submissions (default: tutortime-submissions)
DYNAMODB_TABLE_NAME=

# Name of the private Amazon S3 bucket for applicant CV uploads
UPLOADS_BUCKET_NAME=

# Recipient email address for internal admin submission notifications
ADMIN_NOTIFICATION_EMAIL=

# Verified Amazon SES sender email address for outgoing notifications
SENDER_EMAIL=

# Secret key required in X-Admin-Key header to access the /api/metrics endpoint
ADMIN_API_KEY=

# Toggle applicant confirmation emails: true or false (keep false in SES sandbox)
SEND_CONFIRMATIONS=

# Business contact number for WhatsApp parent chat links (e.g. +12645550199)
WHATSAPP_PHONE_NUMBER=

# Maximum allowed form submissions per IP per 15-minute window (default: 5)
FORM_RATE_LIMIT_MAX=

# Express trust proxy setting: true when running behind reverse proxy or ALB
TRUST_PROXY=

# ==============================================================================
# LEGACY CONFIGURATION (Python/Flask prototype - Preserved for reference)
# ==============================================================================
# LEGACY: SMTP server host for prototype Flask email dispatch
SMTP_SERVER=
# LEGACY: SMTP port for prototype Flask email dispatch
SMTP_PORT=
# LEGACY: App-specific password for prototype Gmail SMTP
SENDER_PASSWORD=
# LEGACY: SQLite database connection string for prototype Flask app
DATABASE_URL=
# LEGACY: Flask environment mode
FLASK_ENV=
# LEGACY: Flask debug mode toggle
FLASK_DEBUG=

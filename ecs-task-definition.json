{
  "family": "popcorn-maths-email-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "popcorn-maths",
      "image": "YOUR_AWS_ACCOUNT_ID.dkr.ecr.YOUR_REGION.amazonaws.com/popcorn-maths:latest",
      "portMappings": [
        {
          "containerPort": 5001,
          "hostPort": 5001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "5001"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "STORAGE_DRIVER",
          "value": "aws"
        },
        {
          "name": "EMAIL_DRIVER",
          "value": "ses"
        },
        {
          "name": "AWS_REGION",
          "value": "YOUR_REGION"
        },
        {
          "name": "DYNAMODB_TABLE_NAME",
          "value": "tutortime-submissions"
        },
        {
          "name": "PORTAL_TABLE_NAME",
          "value": "tutortime-portal"
        },
        {
          "name": "SUBSCRIBERS_TABLE_NAME",
          "value": "popcorn-maths-subscribers"
        },
        {
          "name": "UPLOADS_BUCKET_NAME",
          "value": "YOUR_UPLOADS_BUCKET_NAME"
        },
        {
          "name": "CASSIE_NOTIFICATION_EMAIL",
          "value": "Cassie@tutortime.ai"
        },
        {
          "name": "PORTAL_HOST",
          "value": "checkin.tutortime.ai"
        },
        {
          "name": "CLAUDE_MODEL",
          "value": "claude-haiku-5-5"
        }
      ],
      "secrets": [
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:YOUR_REGION:YOUR_AWS_ACCOUNT_ID:secret:tutortime/production/anthropic-api-key"
        },
        {
          "name": "ADMIN_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:YOUR_REGION:YOUR_AWS_ACCOUNT_ID:secret:tutortime/production/admin-api-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/popcorn-maths",
          "awslogs-region": "YOUR_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"require('http').get('http://localhost:5001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})\""],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 5
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/ecsTaskRole"
}
